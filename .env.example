# ── Database ────────────────────────────────────────────────
# MVP default: JSON file adapter (no setup needed).
# For production set DATABASE_ADAPTER=postgres and provide DATABASE_URL
DATABASE_ADAPTER=json
DATABASE_URL=

# ── Auth ────────────────────────────────────────────────────
AUTH_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma separated emails that get admin access
ADMIN_EMAILS=

# ── AI providers ────────────────────────────────────────────
# TEXT_AI_PROVIDER: demo | openai | gemini   (fallback chain: comma separated)
TEXT_AI_PROVIDER=demo
TEXT_AI_API_KEY=
TEXT_AI_MODEL=
# IMAGE_AI_PROVIDER: demo | openai | gemini
IMAGE_AI_PROVIDER=demo
IMAGE_AI_API_KEY=
IMAGE_AI_MODEL=

# ── Rate limiting / storage ────────────────────────────────
REDIS_URL=
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# ── Payments ────────────────────────────────────────────────
PAYMENT_PROVIDER=disabled
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# ── Public config ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# ── Usage limits (daily) ────────────────────────────────────
LIMIT_ANON_TEXT=3
LIMIT_ANON_IMAGE=1
LIMIT_FREE_TEXT=10
LIMIT_FREE_IMAGE=2
LIMIT_PRO_TEXT=200
LIMIT_PRO_IMAGE=40
